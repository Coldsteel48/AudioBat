{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ramkolfxd (daemon)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/daemon/ramkolfxd",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "Debug ramkolfx-gui",
            "type": "cppdbg",
            "request": "launch",
